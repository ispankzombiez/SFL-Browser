<?xml version="1.0" encoding="utf-8"?>
<!-- One timer row inside a section panel: the softer tan with the game's
     dark outline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/sfl_panel_soft" />
    <stroke
        android:width="1dp"
        android:color="@color/sfl_ink" />
    <corners android:radius="4dp" />
</shape>
