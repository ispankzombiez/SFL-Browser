<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsInfoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sfl_page"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/sfl_cream"
        app:titleTextColor="@color/sfl_text_white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/settingsInfoContent"
            style="@style/SettingsPage"
            android:layout_margin="8dp"
            android:background="@drawable/sfl_bg_app"
            android:tag="palette-canvas"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp" />
    </ScrollView>
</LinearLayout>
