<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sfl_page"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/sfl_page"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/sfl_cream"
        app:title="@string/settings_title"
        app:titleTextColor="@color/sfl_text_white" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/settingsTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sfl_page"
        app:tabMode="scrollable"
        app:tabIndicatorColor="@color/sfl_accent"
        app:tabSelectedTextColor="@color/sfl_accent"
        app:tabTextColor="@color/sfl_text_white" />

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/sfl_page"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="@drawable/sfl_bg_app"
            android:tag="palette-canvas"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

        <LinearLayout
            android:id="@+id/settingsBrowserPage"
            style="@style/SettingsPage">

        <TextView
            style="@style/SettingsHeading"
            android:text="@string/section_appearance" />

        <Button
            android:id="@+id/btnBrowserLayout"
            style="@style/SettingsLinkButton"
            android:text="@string/browser_layout_title" />

        <Button
            android:id="@+id/btnColorTheme"
            style="@style/SettingsLinkButton"
            android:text="@string/palette_title" />

        <Button
            android:id="@+id/btnNativeFontSize"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:textColor="@color/sfl_text_black" />

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/help_native_font_size" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/hideBrowserControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hide_browser_controls"
            android:textColor="@color/sfl_text_black" />

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/hide_browser_controls_help" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/hideAndroidNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hide_android_navigation"
            android:textColor="@color/sfl_text_black" />

        <TextView
            style="@style/SettingsHeading"
            android:text="@string/section_browser" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/notificationsOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mode_notifications_only"
            android:textColor="@color/sfl_text_black" />

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/help_notifications_only" />

        <Button
            android:id="@+id/btnNotificationApp"
            style="@style/SettingsLinkButton"
            android:visibility="gone" />

        <TextView
            style="@style/SettingsLabel"
            android:text="@string/label_home_url" />

        <EditText
            android:id="@+id/homeUrl"
            style="@style/SettingsInput"
            android:hint="@string/hint_home_url"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1" />

        <TextView
            style="@style/SettingsLabel"
            android:text="@string/label_home_tabs" />

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/help_home_tabs" />

        <LinearLayout
            android:id="@+id/homeTabList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnAddHomeTab"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_add_home_tab"
            android:textAllCaps="false"
            android:textColor="@color/sfl_text_black" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/settingsFarmPage"
            style="@style/SettingsPage"
            android:visibility="gone">

        <TextView
            style="@style/SettingsHeading"
            android:text="@string/section_api" />

        <TextView
            style="@style/SettingsLabel"
            android:text="@string/label_api_key" />

        <EditText
            android:id="@+id/apiKey"
            style="@style/SettingsInput"
            android:hint="@string/hint_api_key"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1" />

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/help_api_key" />

        <TextView
            style="@style/SettingsLabel"
            android:text="@string/label_farm_id" />

        <EditText
            android:id="@+id/farmId"
            style="@style/SettingsInput"
            android:hint="@string/hint_farm_id"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            style="@style/SettingsHeading"
            android:text="@string/section_polling" />

        <TextView
            style="@style/SettingsLabel"
            android:text="@string/label_poll_interval" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/pollValue"
                style="@style/SettingsInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLines="1" />

            <Spinner
                android:id="@+id/pollUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:entries="@array/time_units" />
        </LinearLayout>

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/help_poll_interval" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/wifiOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/label_wifi_only" />

        <Button
            android:id="@+id/btnTestNow"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_test_now"
            android:textColor="@color/sfl_text_black"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/checkStatus"
            style="@style/SettingsHelp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/crashReportingControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/SettingsHeading"
                android:text="@string/crash_reporting_title" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/shareCrashReports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:saveEnabled="false"
                android:text="@string/crash_reporting_switch"
                android:textColor="@color/sfl_text_black" />

            <TextView
                style="@style/SettingsHelp"
                android:text="@string/crash_reporting_help" />
        </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/settingsNotificationsPage"
            style="@style/SettingsPage"
            android:visibility="gone">

        <TextView
            style="@style/SettingsHeading"
            android:text="@string/section_delivery" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/batterySaving"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="@string/label_battery_saving" />

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/help_battery_saving" />

        <TextView
            style="@style/SettingsLabel"
            android:text="@string/label_offset" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/offsetValue"
                style="@style/SettingsInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:importantForAutofill="no"
                android:inputType="numberSigned"
                android:maxLines="1" />

            <Spinner
                android:id="@+id/offsetUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:entries="@array/time_units" />
        </LinearLayout>

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/help_offset" />

        <TextView
            style="@style/SettingsLabel"
            android:text="@string/label_exact_alarm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/exactAlarmStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/exact_alarm_missing" />

            <Button
                android:id="@+id/btnExactAlarm"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_grant_exact_alarm"
                android:textColor="@color/sfl_text_black"
                android:textAllCaps="false"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/help_exact_alarm" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ignoreBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/label_ignore_battery" />

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/help_ignore_battery" />

        <TextView
            style="@style/SettingsHeading"
            android:text="@string/section_grouping" />

        <TextView
            style="@style/SettingsLabel"
            android:text="@string/label_group_window" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/groupWindow"
                style="@style/SettingsInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLines="1" />

            <Spinner
                android:id="@+id/groupWindowUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:entries="@array/time_units" />
        </LinearLayout>

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/help_group_window" />

        <TextView
            style="@style/SettingsHeading"
            android:text="@string/section_triggers" />

        <LinearLayout
            android:id="@+id/timerCategoryToggles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/SettingsLabel"
            android:text="@string/label_cooking_mode" />

        <Spinner
            android:id="@+id/cookingMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/cooking_modes" />

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/help_cooking_mode" />

        <TextView
            style="@style/SettingsLabel"
            android:labelFor="@id/craftingBoxMode"
            android:text="@string/category_crafting_box" />

        <Spinner
            android:id="@+id/craftingBoxMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/help_crafting_box_mode" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/cropMachineAllDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/crop_machine_all_done" />

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/help_crop_machine_all_done" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/enableEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_enable_events" />

        <TextView
            style="@style/SettingsLabel"
            android:text="@string/label_lead_time" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/leadValue"
                style="@style/SettingsInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLines="1" />

            <Spinner
                android:id="@+id/leadUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:entries="@array/time_units" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/enableSales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_enable_sales" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/settingsPricesPage"
            style="@style/SettingsPage"
            android:visibility="gone">

        <TextView
            style="@style/SettingsHeading"
            android:text="@string/section_price_alerts" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/enablePrices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_enable_prices" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/batchedPriceChecks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_batched_price_checks" />

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/help_batched_price_checks" />

        <LinearLayout
            android:id="@+id/priceAlertList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/priceAlertEmpty"
            style="@style/SettingsHelp"
            android:text="@string/price_alert_empty" />

        <Button
            android:id="@+id/btnAddPriceAlert"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_add_price_alert"
            android:textColor="@color/sfl_text_black"
            android:textAllCaps="false" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/settingsAboutPage"
            style="@style/SettingsPage"
            android:visibility="gone">

        <TextView
            style="@style/SettingsHeading"
            android:text="@string/settings_section_about" />

        <Button
            android:id="@+id/btnAboutDev"
            style="@style/SettingsLinkButton"
            android:text="@string/settings_about_dev" />

        <Button
            android:id="@+id/btnCredits"
            style="@style/SettingsLinkButton"
            android:text="@string/settings_credits" />

        <Button
            android:id="@+id/btnTutorial"
            style="@style/SettingsLinkButton"
            android:text="@string/settings_tutorial" />

        <TextView
            style="@style/SettingsHeading"
            android:text="@string/settings_disclaimer_heading" />

        <TextView
            style="@style/SettingsLabel"
            android:text="@string/settings_disclaimer_text" />

        <TextView
            style="@style/SettingsHeading"
            android:text="@string/section_links" />

        <Button
            android:id="@+id/btnPrivacy"
            style="@style/SettingsLinkButton"
            android:text="@string/settings_privacy" />

        <Button
            android:id="@+id/btnGithub"
            style="@style/SettingsLinkButton"
            android:text="@string/settings_github" />

        <Button
            android:id="@+id/btnContact"
            style="@style/SettingsLinkButton"
            android:text="@string/settings_contact" />

        </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
