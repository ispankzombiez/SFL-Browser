    <string name="section_polling">API polling</string>
    <string name="label_poll_interval">Poll the API every</string>
    <string name="help_poll_interval">WorkManager runs this check even when the app is closed. Intervals under 15 minutes use a chain of delayed one-shot workers, so Android may batch them a little — Doze can add a few more minutes while the screen is off.</string>
    <string name="label_wifi_only">Only poll on unmetered (Wi-Fi) networks</string>
    <string name="btn_test_now">Run a check now</string>

    <string name="section_delivery">Delivery</string>
    <string name="label_battery_saving">Battery saving (batch notifications)</string>
    <string name="help_battery_saving">Off by default: due timer groups use alarms. On: due timer groups are delivered at the next poll, which saves battery but can delay notifications.</string>
    <string name="label_offset">Time offset</string>
    <string name="help_offset">Shift every scheduled notification by this much. Negative fires earlier, positive fires later. Example: 5 minutes earlier warns you before the crop is actually ready.</string>
    <string name="offset_negative">earlier</string>
    <string name="offset_positive">later</string>
    <string name="offset_none">exactly on time</string>
    <string name="label_exact_alarm">Exact alarm access</string>
    <string name="exact_alarm_granted">Granted</string>
    <string name="exact_alarm_missing">Not granted — notifications will fire late</string>
    <string name="btn_grant_exact_alarm">Allow exact alarms</string>
    <string name="btn_manage_exact_alarm">Manage exact alarms</string>
    <string name="help_exact_alarm">Needed so a notification can fire at the exact second a crop is ready. Without it Android delivers it whenever it can.</string>
    <string name="label_ignore_battery">Ignore battery optimisation</string>
    <string name="help_ignore_battery">Some devices stop background work unless the app is exempt. Tap to open the system prompt.</string>

    <string name="section_grouping">Grouping</string>
    <string name="label_group_window">Merge same-named items finishing within</string>
    <string name="help_group_window">Timers with the same name that finish within this window share one notification. It uses the last ready time plus your notification offset and shows the total yield when known.</string>

